# backend/.env.test
# 統合テストと E2E の seed 用。**テスト専用の Supabase プロジェクト**を指すこと(本番を指さない)。
# 実値はコミットしない(.gitignore 済み)。CI では GitHub Actions Secrets から書き出される。

# --- 統合テスト(backend/tests/)に必須 ---
# テスト用プロジェクトの URL
TEST_SUPABASE_URL=
# publishable key(旧 anon key)。RLS 越しの検証に使う。
TEST_SUPABASE_PUBLISHABLE_KEY=
# secret key(旧 service_role key)。テストユーザーの作成・削除とテストデータの整理に使う。
# **本番プロジェクトのキーを絶対に入れないこと。**
TEST_SUPABASE_SECRET_KEY=

# --- E2E(frontend/e2e/)の seed に必須 ---
# Maestro のフローがサインインに使うアカウント。CI の値と揃えること
# (揃っていないとローカルと CI でサインインが交互に壊れる)。
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
