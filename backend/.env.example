# backend/.env
# 実際の値はコミットしない。`supabase functions serve --env-file .env` がこれを読み込む。
# 本番は `supabase secrets set` またはダッシュボードでこれらを登録する(このファイルは使われない)。
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY は
# Supabase が Edge Functions に自動注入するため、ここには書かない(書いても上書きされない)。
# ローカルの `supabase functions serve` では `supabase start` の出力に表示される値が自動で使われる。

# Gemini API キー。Google AI Studio で発行する。クライアントには絶対に渡さない。
GEMINI_API_KEY=

# 使用モデル。オーバースペックを避けるため軽量モデルを既定値とする。
GEMINI_MODEL=gemini-2.5-flash-lite

# Gemini 呼び出しのタイムアウト(ミリ秒)。
GEMINI_TIMEOUT_MS=10000

# レート制限
SYNONYM_RATE_LIMIT_PER_DAY=30
SYNONYM_RATE_LIMIT_PER_MINUTE=10

# 生成結果(キャッシュ)の有効期間(日数)。
SYNONYM_CACHE_TTL_DAYS=90

# CORS で許可するオリジン。モバイルアプリからの呼び出しが主であれば "*" のままでよい。
CORS_ALLOWED_ORIGIN=*
