{
  "compilerOptions": {
    "strict": true
  },
  "imports": {
    "zod": "npm:zod@3.23.8",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.45.4"
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check .",
    "test": "deno test"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true,
    "exclude": [
      "_shared/infrastructure/supabase/database.types.ts"
    ]
  }
}
