# frontend/.env.local としてコピーして使う。
# EXPO_PUBLIC_ 接頭辞の変数はビルド時に JS バンドルへ埋め込まれ公開される。
# 秘密情報は置かない（README.md 参照）。

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 任意。Google ネイティブサインインにのみ使う(Web は Supabase 側の OAuth 設定を
# 使うため不要)。未設定でもアプリは起動し、Google ログインボタンを押したときだけ
# エラーになる(docs/frontend-design.md 8.1)。
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
