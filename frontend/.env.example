# frontend/.env
# EXPO_PUBLIC_ 接頭辞の変数はアプリバンドルに平文で埋め込まれる。
# 公開して問題ない値のみを置くこと(publishable key は RLS 前提で公開可)。
# secret key / GEMINI_API_KEY を絶対にここへ書かないこと(docs/security.md)。

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Sign-In の Web クライアント ID(Android/iOS 双方で ID トークン発行に必要)。
# Google Cloud Console で発行(docs/roadmap.md の人間の作業ブロッカーを参照)。
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
