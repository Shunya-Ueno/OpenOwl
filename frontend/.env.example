# frontend/.env
# EXPO_PUBLIC_ 接頭辞の変数はアプリバンドルに平文で埋め込まれる。
# 公開して問題ない値のみを置くこと(publishable key は RLS 前提で公開可)。
# secret key / GEMINI_API_KEY を絶対にここへ書かないこと(docs/security.md)。

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Sign-In のクライアント ID。Google Cloud Console で発行する
# (docs/roadmap.md の人間の作業ブロッカーを参照)。
#
# WEB: Supabase に渡す ID トークンの audience を決めるため必須。
#      Android/iOS どちらのフローでも指定する。
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# IOS: iOS のネイティブフローと URL スキームに必要。Web 用の ID では代用できない
#      (種別の異なるクライアントとして登録されるため)。iOS ビルドをする場合のみ必須。
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
